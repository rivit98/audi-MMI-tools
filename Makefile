# native apps for my MMI 3G+ (see README.md)
#
#   make sdk             build the mmi-sdk Docker image (toolchain + QNX sysroot)
#   make                 cross-compile all apps into build/
#   make check APP=x     show what build/x looks like (ELF header, deps)
#   make sd              assemble build/sd/: on SD insert run.sh runs every test
#                        app in turn, with status screens (showScreen) in between,
#                        rendered on the car by pngondemand
#   make sd SD_APPS="hello hello3"
#                        the same with only those apps (in that order)
#   make test            host-side unit tests (tests/*.c) in the SDK container
#   make apk             build the Android sender: android/out/audi_streaming.apk
#                        (= make -C android; see android/Makefile)
#   make apk-test        its Kotlin unit tests
#   make apk-install     adb install it (adb in the container, phone on USB)
#   make aoa-host        desk test: this PC plays the MMI for the phone app
#                        (the newest streamed picture: build/aoa-host/latest.jpg;
#                        H.264: build/aoa-host/stream.h264)
#   make addr APP=x ADDR="0x8043270 ..."
#                        crash address(es) in build/x -> function, file:line
#   make clips           hello6's and hello9's test videos (build/clips/, ffmpeg
#                        in the mmi-media image; make sd does it when needed)
#   make shell           interactive shell in the SDK container

REPO   := $(abspath $(CURDIR)/../..)
OQ     := $(CURDIR)/third_party/openqnx/trunk
FW     := $(CURDIR)/third_party/HN+R_EU_AU_P1001/extracted/MU9411/ifs-root/51
FWEFS  := $(CURDIR)/third_party/HN+R_EU_AU_P1001/extracted/MU9411/efs-system/51
IMAGE  := mmi-sdk
APP    ?= hello2

# Device libraries we can link against (stubbed in the image).
FWLIBS := $(FW)/proc/boot/libc.so.2 \
          $(addprefix $(FW)/mnt/ifs-root/usr/lib/,libm.so.2 libgf.so.1 libEGL.so.6 libGLES_CM.so.6 libasound.so.2) \
          $(FWEFS)/lib/libusbdi.so.2

RUN := docker run --rm -u $(shell id -u):$(shell id -g) \
       -v $(CURDIR):/src -v $(REPO)/builder:/toolkit-builder:ro -v $(REPO)/core:/toolkit-core:ro \
       -w /src $(IMAGE)

# -O2 needs GCC 16: Debian's sh4 GCC 12.2 miscompiled `a == 0 && b == 0` at
# -O1 and up (docs/gcc-sh4-treg-bug.md). build/.canary stops the build if it
# comes back.
# common/qnx/: a <math.h> for stb_image_write (the sysroot has none), car build only
# build/gen/: the Terminus fonts, generated by sdk/mkfont.py
CFLAGS := -O2 -g -Wall -Isrc/common -Isrc/common/qnx -Ibuild/gen
# C++ apps (CXX_APPS): shle-nto-g++, GCC 16's libstdc++ linked statically
# (sdk/include-c++/README.md: what works, what doesn't). Their src/common C
# files are still compiled as C, in the same command, so no -std here
# (the C++ default of GCC 16 is gnu++20).
CXXFLAGS := $(CFLAGS)

# src/common is shared by the apps, in groups, so each app links only what
# it uses (src/<app>/ holds only that app's own logic):
#   BASE    log.c (SD log), quit.c (stop sources), lmgr.c (layer manager)
#   TEXT    text.c (UTF-8, word wrap, glyphs) + the generated fonts
#   SCREEN  screen.c: a CPU-drawn layer-manager screen (VFB), + TEXT
#   GL      gfx.c (gf + EGL), hud.c (FPS counter), img.c (BMP/PNG)
#   PROC    proc.c: start the unit's own tools from a threaded app
#   IMGDEC  imgdec.c: JPEG decoding (stb_image)
#   CPUMON  cpumon.c: own + unit CPU load, a "cpu:" log line per window (cpustat.c)
#   IOM     iom.c: our own io-media client (graph, input, output, play, events)
#   LIVE    C++ (CXX_APPS only): a live H.264 stream through the unit's
#           io-media and DM642 (hw_stream.cpp, docs/phone-mirroring.md 7.10):
#           h264 + csmp4 + live_stream (pure, tests/test_live.cpp),
#           stream_server (resource manager), player (io-media graph, + IOM),
#           vout (video displayable + dev-videoctrl)
common = $(foreach f,$(1),src/common/$(f).c src/common/$(f).h)
commonxx = $(foreach f,$(1),src/common/$(f).cpp src/common/$(f).h)
BASE   := $(call common,log quit lmgr)
TEXT   := $(call common,text) build/gen/font_big.h build/gen/font_small.h
SCREEN := $(call common,screen vfbcopy) $(TEXT)
IMG    := $(call common,img) src/common/stb_image_write.h
GL     := $(call common,gfx hud) $(IMG)
PROC   := $(call common,proc)
IMGDEC := $(call common,imgdec) src/common/stb_image.h
CPUMON := $(call common,cpumon cpustat)
IOM    := $(call common,iom)
LIVE   := $(call commonxx,h264 csmp4 live_stream stream_server player vout hw_stream) $(IOM)

# Apps: build/<app> from src/<app>/*.c + the src/common groups it uses.
# APPS is everything `make` builds; TESTS are what run.sh executes by
# default, in this order (settings: sd/apps.conf). `make sd` builds and
# puts on the card only SD_APPS (default TESTS) and what they need.
#
# hello and lmprobe are still built but no longer run: both have
# answered their question on the car. hello proved the toolchain produces
# binaries the MMI runs; lmprobe proved the layer-manager / VFB sequence,
# and its d-shot is byte-identical between runs (docs/platform-notes.md).
# Run either with `make sd SD_APPS="lmprobe ..."`.
# hello2 and hello3 joined them: both pass, and what they measured is
# written up in docs/gpu-results.md.
#
# hello4 joined them: probes, all three scenes and the stress steps up to
# 12 tori pass; 16 tori freeze the unit (docs/gpu-results.md sections 8-9).
# Stress steps 16 and up stay commented out (src/hello4/main.c).
#
# hello8, the C++ test (src/hello8/checks.cpp): 19 of 19 pass, and
# "atomics stress" settled the last question (gUSA atomics lose updates
# under QNX, SH-4A LL/SC ones don't; docs/cpp-apps.md). "sync reuse" passes
# too (the SDK's std::mutex calls pthread_mutex_init/destroy), so hello8 is
# not in the default run.
#
# hello7 is a tool, not a test: a live knob and button tester, run when
# needed (`make sd SD_APPS="hello7 ..."`). It is not in the default run:
# the MMI reacts to every button as well, and MENU or BACK brings its own
# screens up over hello7's for the rest of the run.
#
# hello6 is not in the default run: its ten clips give the same answer
# every time, and its main result, hardware H.264 on screen through VCAP 0
# input 1, is rechecked by hello9's c5 control on every hello9 run. What
# it leaves open needs RE or new tests (src/hello6/README.md).
#
# hello5 is not in the default run: all its steps have answered on the car
# (the sound replaces radio and music and follows the volume knob, the
# re-shown screen comes back over the Media screen; src/hello5/README.md).
#
# hello9 is not in the default run: all eight tests have answered on the
# car (skip frames work on the DSP, the io-media queue isn't counted in
# bytes, a 30 fps stream doesn't pay; src/hello9/README.md). It needs the
# driver watching for about 4.5 minutes and puts ~70 MB of test videos on
# the card.
#
# audi_stream_receiver runs until the SD card is pulled, so it is always
# last: pulling the card ends it and the whole run (no final "done" screen;
# everything before it is already on the card).
APPS    := hello lmprobe hello2 hello3 hello4 hello5 hello6 hello7 hello8 hello9 audi_stream_receiver
CXX_APPS := hello8 hello9 audi_stream_receiver
# Tools run.sh uses, also built for the car and put in bin/ on the card.
TOOLS   := pngondemand
TESTS   := audi_stream_receiver
SD_APPS ?= $(TESTS)
# Seconds each status screen is shown: the start screen, and the result
# screen after each app.
PRE_S   := 5
POST_S  := 8

.PHONY: all sdk check sd addr shell clean test apk apk-test apk-install aoa-host clips gusa-scan
all: $(addprefix build/,$(APPS) $(TOOLS))

build/hello:  $(wildcard src/hello/*.c)
# lmprobe: layer manager only (no GL).
build/lmprobe: $(wildcard src/lmprobe/*.c src/lmprobe/*.h) $(BASE)
LIBS_lmprobe := -lgf
build/hello2: $(wildcard src/hello2/*.c) $(BASE) $(GL)
LIBS_hello2 := -lGLES_CM -lgf
build/hello3: $(wildcard src/hello3/*.c src/hello3/*.h) $(BASE) $(GL)
LIBS_hello3 := -lGLES_CM -lgf -lm
build/hello4: $(wildcard src/hello4/*.c src/hello4/*.h) $(BASE) $(GL)
LIBS_hello4 := -lGLES_CM -lgf -lm
# hello5: no GL. Its screen (what to do, which ping is playing, for a phone
# video) is CPU-drawn. Its ping trains (pulse.c) and step g's mixer chimes
# are played by the unit's testapp-file, started with proc.c, and by its
# own io-media client (common/iom.c, step n).
build/hello5: $(wildcard src/hello5/*.c src/hello5/*.h) $(BASE) $(SCREEN) $(PROC) $(IOM)
LIBS_hello5 := -lasound -lgf
# hello6: mirroring assumptions (docs/phone-mirroring.md). GL benchmarks,
# CPU-drawn instruction screens, the unit's tools for video.
build/hello6: $(wildcard src/hello6/*.c src/hello6/*.h) $(BASE) $(GL) $(SCREEN) $(PROC)
LIBS_hello6 := -lGLES_CM -lgf
# hello7: knob/button tester, ch8 decoding in keys.c; CPU-drawn screen.
build/hello7: $(wildcard src/hello7/*.c src/hello7/*.h) $(BASE) $(SCREEN)
LIBS_hello7 := -lgf
# hello8: C++. checks.cpp is plain C++ (also run on the build host by
# tests/test_hello8.cpp); main.cpp shows the results on a CPU-drawn screen.
# The SDK builds with SH-4A LL/SC atomics (sdk/shle-nto-gcc); gusa.cpp is
# built on its own with GCC's old sh4 default, soft-gusa, so "atomics
# stress" still compares the two (llcs.cpp checks the default). ",strict":
# without it GCC uses movli.l/movco.l for 32-bit atomics on SH-4A anyway.
GUSA_FLAGS := -matomic-model=soft-gusa,strict
build/hello8: $(filter-out src/hello8/gusa.cpp,$(wildcard src/hello8/*.cpp)) \
    $(wildcard src/hello8/*.h) build/hello8-gusa.o $(BASE) $(SCREEN)
LIBS_hello8 := -lgf
build/hello8-gusa.o: src/hello8/gusa.cpp src/hello8/checks.h
	mkdir -p build
	$(RUN) shle-nto-g++ $(CXXFLAGS) $(GUSA_FLAGS) -c -o $@ $<
	@$(RUN) sh4-linux-gnu-objdump -d $@ | grep -q movli.l && \
	    { echo "$@: LL/SC in the gUSA loop (GUSA_FLAGS lost ,strict?)"; rm -f $@; exit 1; } || true
# hello9: C++. The streaming tests (docs/phone-mirroring.md 7.8-7.10):
# a raw clip pushed frame by frame through LIVE's
# HwStream, the code audi_stream_receiver uses for the phone's frames
# (stream_server.cpp's headers need src/common/qnx/sys/pm.h). schedule.cpp
# is plain C++, also tested on the build host (tests/test_live.cpp).
build/hello9: $(wildcard src/hello9/*.cpp src/hello9/*.h) $(BASE) $(SCREEN) $(PROC) $(LIVE)
LIBS_hello9 := -lgf
# QNX's <sys/compiler_gnu.h> declares _Uint8t/_Uint32t (uint8_t, uint32_t)
# with __aligned__ at their natural alignment, which g++ reports for every
# std::vector<uint8_t> / std::atomic<uint32_t>. Nothing is lost.
CXXFLAGS_hello9 := -Wno-ignored-attributes
# audi_stream_receiver: USB (libusbdi) + CPU-drawn screen, no GL. The phone's
# pictures are JPEGs, decoded on the CPU, or an
# H.264 stream played by the unit's DM642 through LIVE (hwvideo.cpp), which
# makes it a C++ app; its .c files are still compiled as C.
build/audi_stream_receiver: $(wildcard src/audi_stream_receiver/*.c src/audi_stream_receiver/*.cpp \
    src/audi_stream_receiver/*.h) $(BASE) $(SCREEN) $(IMGDEC) $(CPUMON) $(LIVE)
LIBS_audi_stream_receiver := -lusbdi -lgf
CXXFLAGS_audi_stream_receiver := -Wno-ignored-attributes

# pngondemand: layout text -> PNG (src/pngondemand/README.md), for run.sh's
# status screens. Text drawing + PNG writer, no device libraries.
build/pngondemand: $(wildcard src/pngondemand/*.c src/pngondemand/*.h) $(TEXT) $(IMG)

build/gen/font_big.h: sdk/mkfont.py sdk/fonts/Uni2-TerminusBold32x16.psf.gz
	mkdir -p build/gen
	$(RUN) python3 -I sdk/mkfont.py sdk/fonts/Uni2-TerminusBold32x16.psf.gz font_big $@
build/gen/font_small.h: sdk/mkfont.py sdk/fonts/Uni2-TerminusBold16.psf.gz
	mkdir -p build/gen
	$(RUN) python3 -I sdk/mkfont.py sdk/fonts/Uni2-TerminusBold16.psf.gz font_small $@

sdk:
	rm -rf build/fwlibs && mkdir -p build/fwlibs && cp $(FWLIBS) build/fwlibs/
	docker build -t $(IMAGE) \
	    --build-context qnx-libc-public=$(OQ)/lib/c/public \
	    --build-context qnx-sys-public=$(OQ)/services/system/public \
	    --build-context qnx-crt-sh=$(OQ)/lib/c/startup/sh \
	    --build-context fwlibs=build/fwlibs \
	    .

$(addprefix build/,$(APPS) $(TOOLS)): build/.canary

# The compiler canary: sdk/canary.c's `a == 0 && *p == 0` needs two
# compares (tst / cmp). With the miscompile only one is left.
build/.canary: sdk/canary.c Makefile
	mkdir -p build
	$(RUN) shle-nto-gcc $(CFLAGS) -S -o build/canary.s sdk/canary.c
	@n=$$(awk '/^canary_and:/,/\.size/' build/canary.s | grep -cE '^[[:space:]]+(tst|cmp/)'); \
	if [ "$$n" -lt 2 ]; then \
	    echo "COMPILER CANARY FAILED: canary_and has $$n compare(s), needs 2."; \
	    echo "CFLAGS ($(CFLAGS)) hit the sh4 GCC miscompile, see docs/gcc-sh4-treg-bug.md"; \
	    exit 1; \
	fi; echo "compiler canary ok ($$n compares)"
	touch $@

build/%:
	mkdir -p build
	$(RUN) shle-nto-gcc $(CFLAGS) $(CFLAGS_$*) -o $@ $(filter %.c,$^) $(LIBS_$*)

# C++ apps: the C files from src/common as C, the rest as C++, plus any
# prebuilt objects. g++'s driver takes a -x c for the next .c file only,
# so each gets its own.
$(addprefix build/,$(CXX_APPS)):
	mkdir -p build
	$(RUN) shle-nto-g++ $(CXXFLAGS) $(CXXFLAGS_$(@F)) -o $@ \
	    $(foreach f,$(filter %.c,$^),-x c $(f)) -x none $(filter %.cpp,$^) $(filter %.o,$^) $(LIBS_$(@F))

check: build/$(APP)
	$(RUN) sh -c 'file build/$(APP); sh4-linux-gnu-readelf -h -l -d build/$(APP) | grep -E "Type:|Entry|interpreter|LOAD|NEEDED|HASH|FLAGS|Flags"'

# What each app needs on the card besides its binary; `make sd` takes only
# the SD_APPS' share.
#   CLIPS_<app>    test videos from build/clips/ (media/mkclips.sh), to
#                  card:/clips. The set is generated whole, once, when any
#                  SD app has clips.
#   FWTOOLS_<app>  the unit's own efs tools it starts, to card:/bin. The
#                  apps prefer the unit's copies and fall back to these:
#                  the unit's files, inflated from efs-system
#                  (tools/qnx_inflator.c) into $(FWEFS)/bin.
#   FILES_<app>    other files, to the card root.
# hello6's clips 9 and 10 are c7 and c8, written to the card while they play.
CLIPS_hello6   := c1_mpeg2_576.mpg c2_mpeg4_480.avi c3_h264_480.mp4 c4_h264_800.mp4 \
                  c5_h264_336.mp4 c6_h264_336_na.mp4 c7_h264_336_frag.mp4 c8_h264_336.mpg
CLIPS_hello9   := c5_h264_336.mp4 c9_h264_336_cs.mp4 c11_h264_336.h264
FWTOOLS_hello5 := testapp-file
FWTOOLS_hello6 := testapp-file testapp-cmdline mmecli ShowVideoMemory memusage hbhogs
FWTOOLS_hello9 := testapp-file testapp-cmdline
FILES_hello5   := src/hello5/beep.wav

ifneq ($(filter sd,$(MAKECMDGOALS)),)
ifneq ($(filter-out $(APPS),$(SD_APPS)),)
$(error SD_APPS: not an app: $(filter-out $(APPS),$(SD_APPS)) (APPS: $(APPS)))
endif
endif
per_app   = $(sort $(foreach a,$(SD_APPS),$($(1)_$(a))))
SD_CLIPS  := $(call per_app,CLIPS)
SD_FWTOOLS := $(wildcard $(addprefix $(FWEFS)/bin/,$(call per_app,FWTOOLS)))
SD_FILES  := $(call per_app,FILES)

# Only the SD_APPS are built and copied, plus run.sh's own tools (TOOLS,
# showScreen). Anything else: add it to SD_APPS.
sd: $(addprefix build/,$(SD_APPS) $(TOOLS)) $(SD_FILES) $(if $(SD_CLIPS),build/clips/.done)
	rm -rf build/sd && mkdir -p build/sd/bin build/sd/var
	cp $(addprefix build/,$(SD_APPS) $(TOOLS)) $(SD_FWTOOLS) $(REPO)/core/bin/showScreen build/sd/bin/
	cp sd/apps.conf sd/screens.sh $(SD_FILES) build/sd/
	$(if $(SD_CLIPS),mkdir -p build/sd/clips && cp $(addprefix build/clips/,$(SD_CLIPS)) build/sd/clips/)
	sed -e 's/@APPS@/$(SD_APPS)/' -e 's/@PRE_S@/$(PRE_S)/' \
	    -e 's/@POST_S@/$(POST_S)/' sd/run.sh > build/sd/run.sh
	$(RUN) python3 -I /toolkit-builder/encoder.py encode \
	    /toolkit-core/copie_scr_plain.sh build/sd/copie_scr.sh
	@echo "SD card layout ready in build/sd/ - copy its contents to the card root"
	@echo "  apps (run by run.sh): $(SD_APPS)"
	@echo "  clips: $(or $(SD_CLIPS),none)"
	@echo "  unit tools: $(or $(notdir $(SD_FWTOOLS)),none)"
	@du -sh build/sd | sed 's/\t.*/ on the card/; s/^/  /'

# hello6's and hello9's test videos: media/mkclips.sh in the mmi-media image (ffmpeg).
MEDIA_IMAGE := mmi-media
build/.media-image: media/Dockerfile
	docker build -t $(MEDIA_IMAGE) media
	mkdir -p build && touch $@
build/clips/.done: media/mkclips.sh media/csmp4.py build/.media-image
	rm -rf build/clips && mkdir -p build/clips
	docker run --rm -u $(shell id -u):$(shell id -g) -v $(CURDIR):/src -w /src \
	    $(MEDIA_IMAGE) bash media/mkclips.sh build/clips
	touch $@
clips: build/clips/.done

# Our binaries are ET_EXEC at a fixed base, so an ip/BT address from the
# dumper's slog line or core file maps straight to the unstripped build/x.
addr: build/$(APP)
	$(RUN) sh4-linux-gnu-addr2line -f -i -p -e build/$(APP) $(ADDR)

# Host-side unit tests of the pure parts (protocol, UTF-8/wrap/draw), built
# with the SDK image's native gcc + ASan/UBSan.
TESTBIN := build/test_proto build/test_imgdec build/test_cpustat build/test_text build/test_lz4 build/test_png build/test_layout \
           build/test_pulse build/test_keys build/test_vfbcopy build/test_hello8 build/test_live build/test_config_gate
# test_live also checks the live stream against a real clip: check_live.py
# (mmi-media: ffmpeg) makes it and media/csmp4.py's MP4 of it first, and
# decodes the stream with a filled gap test_live writes afterwards.
MEDIA_RUN = docker run --rm -u $(shell id -u):$(shell id -g) -v $(CURDIR):/src -w /src $(MEDIA_IMAGE)
test: $(TESTBIN) build/.media-image
	rm -rf build/test_live.d && mkdir -p build/test_live.d
	$(MEDIA_RUN) python3 -I tests/check_live.py prepare build/test_live.d
	@for t in $(TESTBIN); do $(RUN) ./$$t || exit 1; done
	$(RUN) python3 -I tests/check_png.py build/test_png.d
	$(MEDIA_RUN) python3 -I tests/check_live.py check build/test_live.d
build/test_proto: tests/test_proto.c tests/check.h src/audi_stream_receiver/proto.c src/audi_stream_receiver/proto.h \
                  src/audi_stream_receiver/vasm.c src/audi_stream_receiver/vasm.h
# audi_stream_receiver's JPEG decoding, on pictures stb_image_write encodes
build/test_imgdec: tests/test_imgdec.c tests/check.h $(IMGDEC) src/common/stb_image_write.h
TESTLIBS_test_imgdec := -lm
build/test_cpustat: tests/test_cpustat.c tests/check.h $(call common,cpustat)
build/test_text:  tests/test_text.c tests/check.h $(call common,text)
# lz4mini against the reference liblz4 (liblz4-dev in the SDK image)
build/test_lz4:   tests/test_lz4.c tests/check.h src/hello6/lz4mini.c src/hello6/lz4mini.h
TESTLIBS_test_lz4 := -llz4
# the PNG output (common/img.c over stb_image_write): test_png writes PNGs + their raw pixels
# into build/test_png.d/, tests/check_png.py decodes them with Python's zlib.
build/test_png:    tests/test_png.c tests/check.h src/common/img.c src/common/img.h \
                   src/common/stb_image_write.h src/common/text.c
build/test_layout: tests/test_layout.c tests/check.h src/pngondemand/layout.c \
                   src/pngondemand/layout.h src/common/text.c \
                   build/gen/font_big.h build/gen/font_small.h
# screen.c's full / changed-span VFB copy
build/test_vfbcopy: tests/test_vfbcopy.c tests/check.h src/common/vfbcopy.c src/common/vfbcopy.h
# hello5's ping train and WAV header
build/test_pulse:  tests/test_pulse.c tests/check.h src/hello5/pulse.c src/hello5/pulse.h
# hello7's ch8 decoding, on messages logged from the car
build/test_keys:   tests/test_keys.c tests/check.h src/hello7/keys.c src/hello7/keys.h
# hello8's checks with the host's own libstdc++ (C++, so its own rule)
build/test_hello8: tests/test_hello8.cpp tests/check.h src/hello8/checks.cpp src/hello8/llcs.cpp src/hello8/gusa.cpp \
    src/hello8/checks.h
	mkdir -p build
	$(RUN) g++ -std=gnu++20 -O1 -g -Wall -Wextra -fsanitize=address,undefined -Itests -Isrc/hello8 \
	    -o $@ $(filter %.cpp,$^)
# LIVE's pure part (H.264 bits, CS-MP4 header, the live stream with gap
# fill) and hello9's release schedule
build/test_live: tests/test_live.cpp tests/check.h $(call commonxx,h264 csmp4 live_stream) \
    src/hello9/schedule.cpp src/hello9/schedule.h
	mkdir -p build
	$(RUN) g++ -std=gnu++20 -O1 -g -Wall -Wextra -fsanitize=address,undefined -Itests -Isrc/common \
	    -Isrc/hello9 -o $@ $(filter %.cpp,$^)
# audi_stream_receiver: which H264_CONFIGs restart the stream
build/test_config_gate: tests/test_config_gate.cpp tests/check.h src/audi_stream_receiver/config_gate.h
	mkdir -p build
	$(RUN) g++ -std=gnu++20 -O1 -g -Wall -Wextra -fsanitize=address,undefined -Itests -Isrc/audi_stream_receiver \
	    -o $@ $(filter %.cpp,$^)
$(filter-out build/test_hello8 build/test_live build/test_config_gate,$(TESTBIN)):
	mkdir -p build
	$(RUN) gcc -O1 -g -Wall -Wextra -fsanitize=address,undefined -Itests -Isrc/audi_stream_receiver \
	    -Isrc/hello6 -Isrc/hello5 -Isrc/hello7 -Isrc/pngondemand -Isrc/common -Ibuild/gen -o $@ $(filter %.c,$^) $(TESTLIBS_$(@F))

# gUSA atomic sequences left in the built apps (tools/gusa-scan.awk): the
# SDK builds with LL/SC, so only what is precompiled into libstdc++.a /
# libgcc_eh.a (C++ apps) and hello8's deliberate gusa.cpp should show.
gusa-scan: $(addprefix build/,$(APPS))
	@$(RUN) sh -c 'for a in $(APPS); do \
	    n=$$(sh4-linux-gnu-objdump -d --no-show-raw-insn build/$$a | awk -f tools/gusa-scan.awk | wc -l); \
	    echo "$$a: $$n gUSA sequence(s)"; \
	    sh4-linux-gnu-objdump -d --no-show-raw-insn build/$$a | awk -f tools/gusa-scan.awk | \
	        sort | uniq -c | sed "s/^/    /"; \
	done' | c++filt

# Android sender: its own Makefile (android/Makefile), everything in Docker.
apk:
	$(MAKE) -C android
apk-test:
	$(MAKE) -C android test
apk-install:
	$(MAKE) -C android install

# Desk test of the phone app without the car: tools/aoa_host.py plays the
# MMI (AOA handshake + protocol) over the PC's USB. Stop adb first.
aoa-host:
	docker build -q -t mmi-aoa-host -f tools/Dockerfile.aoa-host tools
	mkdir -p build/aoa-host
	docker run --rm -it --privileged -v /dev/bus/usb:/dev/bus/usb \
	    -v $(CURDIR)/build/aoa-host:/out mmi-aoa-host --save /out

shell:
	docker run --rm -it -u $(shell id -u):$(shell id -g) -v $(CURDIR):/src -w /src $(IMAGE) bash

clean:
	rm -rf build
