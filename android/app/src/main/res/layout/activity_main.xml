<?xml version="1.0" encoding="utf-8"?>
<!-- The MMI link's status on top, then the Android Auto mode (MainActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                style="@style/OptionRow"
                android:paddingStart="8dp">

                <Button
                    android:id="@+id/aa_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aa_stop" />

                <TextView
                    android:id="@+id/aa_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/info_aa"
                    style="@style/InfoButton" />
            </LinearLayout>

            <!-- Android Auto's UI as the MMI shows it; touches go to Android Auto -->
            <mmi3g.audistreaming.AaPreview
                android:id="@+id/aa_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <LinearLayout style="@style/OptionRow">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minEms="5"
                    android:text="@string/aa_video_size"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/aa_video_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:entries="@array/aa_video_sizes" />

                <ImageButton
                    android:id="@+id/info_aa_video_size"
                    style="@style/InfoButton" />
            </LinearLayout>

            <include
                android:id="@+id/aa_options"
                layout="@layout/stream_options" />

            <Button
                android:id="@+id/aa_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/aa_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/aa_how_to"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
