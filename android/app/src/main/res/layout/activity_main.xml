<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textSize="14sp" />

    <!-- seconds.milliseconds, redrawn every display frame while on: a photo
         of the phone and the MMI side by side shows both clocks, and the
         difference is the delay -->
    <TextView
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#FFEB3B"
        android:textSize="64sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        style="@style/OptionRow"
        android:paddingStart="8dp">

        <Button
            android:id="@+id/stream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/stream_start" />

        <TextView
            android:id="@+id/video_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/info_stream"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout style="@style/OptionRow">

        <Switch
            android:id="@+id/details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/details" />

        <ImageButton
            android:id="@+id/info_details"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout style="@style/OptionRow">

        <TextView
            android:id="@+id/fps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minEms="5"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/fps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/info_fps"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout style="@style/OptionRow">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minEms="5"
            android:text="@string/format"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/format"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/formats" />

        <ImageButton
            android:id="@+id/info_format"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout style="@style/OptionRow">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minEms="5"
            android:text="@string/bit_rate"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/bit_rate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/bit_rates" />

        <ImageButton
            android:id="@+id/info_bit_rate"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout style="@style/OptionRow">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minEms="5"
            android:text="@string/vcap_mode"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/vcap_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:entries="@array/vcap_modes" />

        <ImageButton
            android:id="@+id/info_vcap_mode"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout style="@style/OptionRow">

        <Switch
            android:id="@+id/sharp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sharp" />

        <ImageButton
            android:id="@+id/info_sharp"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout style="@style/OptionRow">

        <Switch
            android:id="@+id/clock_switch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/latency_clock" />

        <ImageButton
            android:id="@+id/info_clock"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout
        style="@style/OptionRow"
        android:paddingStart="12dp">

        <CheckBox
            android:id="@+id/hide_nav_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hide_nav_bar" />

        <ImageButton
            android:id="@+id/info_hide_nav_bar"
            style="@style/InfoButton" />
    </LinearLayout>

    <LinearLayout
        style="@style/OptionRow"
        android:paddingStart="12dp">

        <CheckBox
            android:id="@+id/keep_screen_on"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/keep_screen_on" />

        <ImageButton
            android:id="@+id/info_keep_screen_on"
            style="@style/InfoButton" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/how_to"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:textSize="12sp" />
</LinearLayout>
</ScrollView>
