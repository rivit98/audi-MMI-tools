#!/bin/sh
# shle-nto-gcc - Debian's sh4-linux-gnu-gcc driven as a QNX 6.3 SH4 (shle)
# compiler. Compiles against openqnx headers, links with QNX's crt objects
# and stub libraries of the MMI's real .so files.
#
# Usage is like gcc:  shle-nto-gcc -O2 -o hello hello.c [-lm -lgf ...]
# -c / -S / -E only compile; otherwise the QNX link line is added.

SYSROOT="${MMI_SYSROOT:-/opt/mmi-sdk/sysroot}"
CC="${MMI_CC:-sh4-linux-gnu-gcc}"

# Code generation: SH4, little endian, FPU in double-precision mode (crt1
# sets FPSCR.PR=1, which is what -m4 assumes). --isa=sh4 makes the assembler
# reject SH-4A-only opcodes and mark the ELF "sh4" (Debian's default: sh4a).
# Non-PIE, because QNX 6.3's loader expects ET_EXEC binaries like the stock
# ones (base 0x08040000).
# Linux-isms GCC would otherwise bake in are switched off. EGL native types
# become void*: on QNX GF they are gf_dev_t / gf_3d_target_t pointers.
# GCC fuses sin(x) + cos(x) into glibc's sincos(), which QNX's libm.so.2
# does not have: taking away the sin/cos builtins stops that.
CFLAGS="-m4 -ml -Wa,--isa=sh4 -fno-pie -fno-stack-protector
        -fno-builtin-sin -fno-builtin-sinf -fno-builtin-sinl
        -fno-builtin-cos -fno-builtin-cosf -fno-builtin-cosl
        -nostdinc -isystem $SYSROOT/usr/include
        -isystem $($CC -print-file-name=include)
        -U__linux__ -U__linux -Ulinux -U__gnu_linux__
        -D__QNX__ -D__QNXNTO__ -D__SH__ -D__LITTLEENDIAN__
        -D__QNXNTO_VERSION__=632
        -DEGL_NO_PLATFORM_SPECIFIC_TYPES"

link=1
for a in "$@"; do
    case "$a" in -c|-S|-E|-M|-MM) link=0 ;; esac
done

if [ $link = 0 ]; then
    exec $CC $CFLAGS "$@"
fi

L="$SYSROOT/usr/lib"
# QNX link order: crt1 crti crtbegin <user objs + libs> -lc libgcc crtend crtn
# - DT_HASH only (no .gnu.hash): the 2008-era ldqnx predates GNU hash.
# - 4 KB segment alignment like the stock binaries (ld default is 64 KB).
# - -z now: resolve everything at load, no reliance on lazy-PLT resolver ABI.
# - interpreter: QNX's /usr/lib/ldqnx.so.2 (a link to libc.so.2 on target).
exec $CC $CFLAGS -nostdlib -no-pie \
    -Wl,--dynamic-linker=/usr/lib/ldqnx.so.2 \
    -Wl,-Ttext-segment=0x08040000 \
    -Wl,--hash-style=sysv -Wl,--build-id=none -Wl,-z,norelro -Wl,-z,now \
    -Wl,-z,max-page-size=0x1000 -Wl,-z,noexecstack \
    -Wl,--no-as-needed \
    "$L/crt1.o" "$L/crti.o" "$L/crtbegin.o" "$L/crtarray.o" \
    -L"$L" "$@" -lc "$($CC -m4 -ml -print-libgcc-file-name)" \
    "$L/crtend.o" "$L/crtn.o"
