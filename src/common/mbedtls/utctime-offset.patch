android_auto: accept a UTCTime / GeneralizedTime with a +hhmm / -hhmm
offset. The Android Auto head unit certificate (aasdk's cert/headunit.crt)
has "140704000000-0700" / "450429142838-0700", which mbedTLS refuses
("X509 - The date tag or value is invalid"). The offset is skipped, not
applied: the head unit never checks the dates (no clock, VERIFY_NONE).
Applied by the Makefile after unpacking mbedTLS.

--- a/library/x509.c
+++ b/library/x509.c
@@ -676,9 +676,14 @@
         return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_DATE, ret);
     }

-    /* len is 12 or 14 depending on year_len, plus optional trailing 'Z' */
+    /* len is 12 or 14 depending on year_len, plus optional trailing 'Z',
+     * or (android_auto) a +hhmm / -hhmm offset, which is ignored: the
+     * Android Auto head unit certificate has one, and its dates are never
+     * checked */
     if (len != year_len + 10 &&
-        !(len == year_len + 11 && (*p)[(len - 1)] == 'Z')) {
+        !(len == year_len + 11 && (*p)[(len - 1)] == 'Z') &&
+        !(len == year_len + 15 && ((*p)[year_len + 10] == '+' ||
+                                   (*p)[year_len + 10] == '-'))) {
         return MBEDTLS_ERR_X509_INVALID_DATE;
     }

