# mmi-aoa-host - runs tools/aoa_host.py (desk stand-in for the MMI) with
# libusb and a window (tools/aoa_screen.py). `make aoa-host` starts it with
# /dev/bus/usb and the X11 socket passed through.
FROM ghcr.io/astral-sh/uv:0.5.11-python3.12-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libusb-1.0-0 \
    libx11-6 libxext6 libxcursor1 libxi6 libxrandr2 libxfixes3 libxss1 \
 && rm -rf /var/lib/apt/lists/*

ENV UV_CACHE_DIR=/tmp/uv-cache
COPY aoa_host.py aoa_screen.py /opt/
# Resolve the script's pinned dependencies at build time.
RUN uv run --script /opt/aoa_host.py --check \
 && chmod -R a+rwX /tmp/uv-cache
ENTRYPOINT ["uv", "run", "--script", "/opt/aoa_host.py"]
